# Esempio di configurazione client OpenVPN per il tunnel site-to-site verso
# Citizen Care Connect (CCHS), alternativa a WireGuard (vedi wg-cchs.conf.example)
# se il fornitore consegna un profilo OpenVPN invece che WireGuard.
#
# Copiare in /etc/openvpn/client/cchs.conf e compilare i valori tra <>
# con quelli forniti da CCHS in fase di onboarding. Certificati/chiavi
# (ca.crt, client.crt, client.key) forniti separatamente dal fornitore:
# NON committarli nel repository — vanno tenuti fuori dal controllo versione
# (permessi 600, root:root), come da CLAUDE.md "niente dati paziente/segreti nei commit".
#
# Attivazione manuale:   sudo openvpn --config /etc/openvpn/client/cchs.conf
# Attivazione al boot:   sudo systemctl enable --now openvpn-client@cchs
#
# In config.json del middleware, con tunnel gestito da systemd (consigliato):
#   "vpn_enabled": true, "vpn_provider": "openvpn", "vpn_interface": "cchs",
#   "vpn_manage_lifecycle": false,
#   "vpn_health_check_host": "<IP interno CCHS lato tunnel>",
#   "vpn_health_check_port": <porta ADT/ORM CCHS>

client
dev tun
proto udp
remote <vpn.citizencarehealth.com> <1194>
resolv-retry infinite
nobind
persist-key
persist-tun

ca /etc/openvpn/client/cchs-ca.crt
cert /etc/openvpn/client/cchs-client.crt
key /etc/openvpn/client/cchs-client.key

remote-cert-tls server
cipher AES-256-GCM
auth SHA256
verb 3
